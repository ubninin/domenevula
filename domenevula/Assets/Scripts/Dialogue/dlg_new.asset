  - speaker: {fileID: 11400000, guid: 6c8a073a93f880e45b82f0c7d966b06e, type: 2}
    text: "\uAC13 \uC0DD\uC744 \uC0AC\uB294\uAC8C \uC544\uB2C8\uB77C\r\n\uC9C0\uB09C\uB0A0\uC758
