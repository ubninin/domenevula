  lines:
  - speaker: {fileID: 11400000, guid: 6c8a073a93f880e45b82f0c7d966b06e, type: 2}
    text: "\uC774\uB807\uAC8C\uD574\uB450\uB2C8\uAE4C \uC54C\uB9CC\uD234\uAC19\uB2E4"
    portraitOverride: {fileID: -8548035357666841804, guid: 7ff829ba5dce61e48aabad8e5cc329cf, type: 3}
  - speaker: {fileID: 11400000, guid: 6c8a073a93f880e45b82f0c7d966b06e, type: 2}
    text: "\uB108\uC640\uD0A4\uC2A4\uB97C\uD588\uB530\uC6B0\uB9AC\uC758\uD600\uB294\uB4DC\uB9BC\uC138\uD0C1\uAE30\uCC98\uB7FC\uC11C\uB85C\uC758\uC785\uC18D\uC744\uD718\uC800\uC5C8\uB2E4\uC5B4\uCC0C\uB098\uAC01\uB82C\uD55C\uC9C0\uB2EC\uACE0\uB098\uCEE4\uD53C\uB97C\uB9CC\uB4E4\uC218\uC788\uC744\uC815\uB3C4\uC600\uB530\uC785\uC744\uB5BC\uACE0\uB108\uB97C\uCCD0\uB2E4\uBCF4\uB2C8\uB108\uC73C\uC5BC\uAD74\uC740\uB9C8\uCE58\uD1A0\uB9C8\uD1A0\uAC19\uC774\uBD89\uC5C8\uB2E4.\uADF8\uBAA8\uC2B5\uC5D0\uB098\uB294\uB2E4\uC2DC\uB108\uC73C\uC785\uC220\uB85C\uB3CC\uC9C4\uD588\uB530\uB808\uACE0\uCC98\uB7FC\uB9DE\uBB3C\uB9B0\uC785\uC220\uC0AC\uC774\uB85C\uD600\uB97C\uB123\uC5B4\uAD6C\uC11D\uAD6C\uC11D\uC591\uCE58\uD558\uB4EF\uC717\uB2C8\uC544\uB7AB\uB2C8\uACE8\uACE0\uB8E8\uBB38\uC9C8\uB800\uB2E4.\uB098\uB294
      \uADF8\uC758 \uC785\uC5D0 \uB0B4 \uC785\uC744 \uC0B4\uBA70\uC2DC \uD3EC\uAC1C\uC5C8\uB2E4.
      \uC5BC\uAD74\uC774 \uACBD\uACE0\uB4F1\uC744 \uD45C\uC2DC\uD558\uB4EF \uBD89\uAC8C
      \uD0C0\uC62C\uB790\uC9C0\uB9CC, \uB098\uB294 \uADF8 \uACBD\uACE0\uB97C \uC560\uC368
      \uBB34\uC2DC\uD558\uB824\uB294 \uB4EF, \uADF8\uC758 \uC785\uC548\uC73C\uB85C
      \uD600\uB97C \uC9D1\uC5B4\uB123\uC5C8\uB2E4.\uD600\uB05D\uC73C\uB85C \uADF8\uC758
      \uD600\uAC00 \uB290\uAEF4\uC9C0\uB294 \uAC10\uAC01\uC774 \uB290\uAEF4\uC9C0\uACE0,
      \uADF8\uB294 \uCC98\uC74C\uC5D0\uB294 \uD600\uB97C \uC6C0\uCE20\uB838\uC9C0\uB9CC,
      \uC11C\uC11C\uD788 \uB0B4 \uD600\uB97C \uAC10\uC544\uC624\uAE30 \uC2DC\uC791\uD588\uB2E4.\uB9C8\uCE58
      \uC628 \uC2E0\uACBD\uC744 \uD600\uC5D0 \uC9D1\uC911\uD558\uB294 \uB4EF, \uB098\uB294
      \uB208\uC744 \uAC10\uC740 \uCC44 \uADF8\uC640 \uD600\uB97C \uC11E\uAE30 \uC2DC\uC791\uD558\uC600\uB2E4.
      \uACC4\uC18D\uD574\uC11C \uD600\uB97C \uC11E\uACE0 \uC788\uB358 \uD0D3\uC774\uC9C0,
      \uC785\uC548\uC5D0\uC11C \uD758\uB7EC\uB098\uC628 \uCE68\uC774 \uC785\uC5D0\uACE0\uC5EC
      \uC774\uB0B4 \uBC14\uB2E5\uC744 \uD5A5\uD574 \uB5A8\uC5B4\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4.
      \uBC14\uB2E5\uC73C\uB85C \uB5A8\uC5B4\uC9C0\uB294 \uCE68\uC740 \uC911\uB825\uAC00\uC18D\uB3C4\uC758
      \uC601\uD5A5\uC744 \uCDA9\uC2E4\uD558\uAC8C \uBC1B\uC544 \uC870\uB9CC\uAC04
      \uBC14\uB2E5\uC5D0 \uB5A8\uC5B4\uC9C8\uAC83\uC774\uB2E4.\uC774\uB54C, \uC704\uCE58
      \uC5D0\uB108\uC9C0\uAC00 \uC6B4\uB3D9\uC5D0\uB108\uC9C0\uB85C \uBCC0\uD658\uB418\uC5B4
      \uCE68\uC758 \uC9C8\uB7C9\uC744 \uB2A5\uAC00\uD558\uB294 "
    portraitOverride: {fileID: -8548035357666841804, guid: 7ff829ba5dce61e48aabad8e5cc329cf, type: 3}
  - speaker: {fileID: 11400000, guid: 7c1c994066242af4cab2c4b26a30bf86, type: 2}
    text: "\uC640 \uC0CC\uC988 \uC640 \uD30C\uD53C\uB8E8\uC2A4"
    portraitOverride: {fileID: 5204121869891066701, guid: c27b4d3b33c9863489afe51a4a50f501, type: 3}
  - speaker: {fileID: 11400000, guid: 7c1c994066242af4cab2c4b26a30bf86, type: 2}
    text: "\uADF8\uB798\uC0AC\uB791\uC744\uD574\uBCF4\uC790dinnadinna\uC124\uB808\uAC8C\uD574dinnadinna\uC880\uBD10dinnadinnalakhs\uC758\uAC15\uB3C4\uADF8\uB798\uC0AC\uB791\uC744\uD574\uBCF4\uC790dinnadinna\uC124\uB808\uAC8C\uD574dinnadinna\uC880\uBD10dinnadinnalakhs\uC758\uAC15\uB3C4\r\n\n\uADF8\uB798\uC0AC\uB791\uC744\uD574\uBCF4\uC790dinnadinna\uC124\uB808\uAC8C\uD574dinnadinna\uC880\uBD10dinnadinnalakhs\uC758\uAC15\uB3C4\uADF8\uB798\uC0AC\uB791\uC744\uD574\uBCF4\uC790dinnadinna\uC124\uB808\uAC8C\uD574dinnadinna\uC880\uBD10dinnadinnalakhs\uC758\uAC15\uB3C4\r\n\n\uADF8\uB798\uC0AC\uB791\uC744\uD574\uBCF4\uC790dinnadinna\uC124\uB808\uAC8C\uD574dinnadinna\uC880\uBD10dinnadinnalakhs\uC758\uAC15\uB3C4\uADF8\uB798\uC0AC\uB791\uC744\uD574\uBCF4\uC790dinnadinna\uC124\uB808\uAC8C\uD574dinnadinna\uC880\uBD10dinnadinnalakhs\uC758\uAC15\uB3C4\r\n\n"
    portraitOverride: {fileID: 5204121869891066701, guid: c27b4d3b33c9863489afe51a4a50f501, type: 3}
