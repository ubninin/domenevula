    balloonTailOverride: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 6c8a073a93f880e45b82f0c7d966b06e, type: 2}
    text: "\uC5B4\uB290 \uB0A0 \uC8FC\uBE0C\uB2C9\uC2A4\uB294 \uC7A0\uC5D0\uC11C
      \uAE68\uC5B4\uB0AC\uC744 \uB54C \uBB38\uB4DD \uC790\uC2E0\uC758 \uCB49 \uBED7\uC740
      \uB2E4\uB9AC\uB294 \uD751\uD45C\uBC94\uC744 \uB2EE\uC558\uACE0 \uB208\uBE5B\uC5D4
      \uB3C5\uAE30\uAC00 \uAC00\uB4DD\uD558\uC5EC \uB4E4\uC5B4\uAC08\uB370 \uB4E4\uC5B4\uAC00\uACE0
      \uB098\uC62C\uB370\uB294 \uB098\uC628 \uCF5C\uB77C\uBCD1\uAC19\uC740 \uBAB8\uB9E4\uAC00
      \uC2DC\uADF8\uB9C8\uB4E4\uC744 \uBBF8\uCE58\uAC8C \uD558\uB294 \uC740\uAD50
      \uAC19\uB2E4\uB294 \uC0DD\uAC01\uC774 \uB4E4\uC5B4 \uC8FC\uC800\uC549\uC544
      \uD558\uC5FC\uC5C6\uC774 \uC624\uC5F4\uD588\uB2E4"
